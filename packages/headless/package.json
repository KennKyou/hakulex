{
  "name": "@hakulex/headless",
  "type": "module",
  "version": "0.3.0",
  "description": "Read hakulex documents on a server and turn them into Markdown, without a browser or Vue",
  "author": "Ken (https://github.com/KennKyou)",
  "license": "MIT",
  "homepage": "https://hakulex.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KennKyou/hakulex.git",
    "directory": "packages/headless"
  },
  "bugs": {
    "url": "https://github.com/KennKyou/hakulex/issues"
  },
  "keywords": [
    "hakulex",
    "vue",
    "vue3",
    "lexical",
    "rich-text-editor",
    "wysiwyg",
    "editor",
    "headless",
    "markdown",
    "node"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./transformers": "./src/transformers.ts"
  },
  "main": "./src/index.ts",
  "files": [
    "NOTICE",
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev:build": "vite build --watch"
  },
  "peerDependencies": {
    "lexical": "^0.53.0"
  },
  "dependencies": {
    "@lexical/code-core": "^0.53.0",
    "@lexical/extension": "^0.53.0",
    "@lexical/link": "^0.53.0",
    "@lexical/list": "^0.53.0",
    "@lexical/markdown": "^0.53.0",
    "@lexical/rich-text": "^0.53.0",
    "@lexical/table": "^0.53.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs"
      },
      "./transformers": {
        "types": "./dist/transformers.d.ts",
        "import": "./dist/transformers.mjs"
      }
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts"
  },
  "devDependencies": {
    "@hakulex/editor": "workspace:*",
    "@lexical/headless": "^0.53.0",
    "lexical": "^0.53.0"
  }
}
