{
  "name": "@hakulex/diff",
  "type": "module",
  "version": "0.0.0",
  "description": "Show what changed between two hakulex documents, side by side or in one column",
  "license": "MIT",
  "keywords": [
    "hakulex",
    "vue",
    "vue3",
    "lexical",
    "rich-text-editor",
    "wysiwyg",
    "editor",
    "diff",
    "compare"
  ],
  "sideEffects": [
    "**/*.css",
    "./src/index.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./src/styles.css"
  },
  "main": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev:build": "vite build --watch"
  },
  "peerDependencies": {
    "lexical": "^0.53.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@hakulex/diff-core": "workspace:*",
    "@hakulex/renderer": "workspace:*",
    "@hakulex/style-token": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs"
      },
      "./style.css": "./dist/style.css"
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts"
  },
  "devDependencies": {
    "lexical": "^0.53.0"
  }
}
