{
  "name": "@hakulex/plugin-table",
  "type": "module",
  "version": "0.0.0",
  "description": "Table row and column handles plugin for hakulex",
  "license": "MIT",
  "keywords": [
    "hakulex",
    "vue",
    "vue3",
    "lexical",
    "rich-text-editor",
    "wysiwyg",
    "editor",
    "plugin",
    "table"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./src/styles.css"
  },
  "main": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev:build": "vite build --watch"
  },
  "peerDependencies": {
    "lexical": "^0.53.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@hakulex/editor": "workspace:*",
    "@hakulex/vue-lexical": "workspace:*",
    "@lexical/table": "^0.53.0",
    "@lexical/utils": "^0.53.0",
    "@lucide/vue": "^1.66.0",
    "reka-ui": "^2.11.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs"
      },
      "./style.css": "./dist/style.css"
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts"
  },
  "devDependencies": {
    "lexical": "^0.53.0"
  }
}
