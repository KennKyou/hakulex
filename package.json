{
  "name": "hakulex",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "description": "Lexical-based rich text editor ecosystem for Vue 3.",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm --filter ./demo dev",
    "build": "pnpm -r --filter './packages/*' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:cross": "playwright test --project=firefox --project=webkit",
    "typecheck": "pnpm -r --parallel exec vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/server-renderer": "^3.5.44",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.3",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.14"
  }
}
